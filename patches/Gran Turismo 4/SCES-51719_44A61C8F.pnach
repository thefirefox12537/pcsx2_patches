gametitle=Gran Turismo 4 [SCES-51719] (E) crc=44A61C8F

[Autoboot in 16:9]
author=CRASHARKI
description=Enable Native Widescreen when the game is startup.
; Force Aspect Ratio option to 16:9
patch=1,EE,006184F0,byte,1
patch=1,EE,00A567D4,byte,1
; The Monitor from Secret options it cannot you modify manually:
patch=1,EE,00A567EC,word,438A05E3 // Distance view (in mm)
patch=1,EE,00A567F0,word,43D48000 // Screen width (in mm)
patch=1,EE,00A567F4,word,43700000 // Screen height (in mm)

[Widescreen 16:9]
author=Aero_
description=Corrects the text aspect ratio when 16:9 is selected in the options menu.
