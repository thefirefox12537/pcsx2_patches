[360° View Chase Camera]
author=Nenkai (Ported from Duchi/Vyerq)
description=When looking backwards, the camera can be rotated horizontally with right analog stick.
; Jump to 0xF1100 (custom code) at computeViewAngle() - 0x206488
patch=1,EE,20206488,extended,0C03C440
; New function start - Get pad value (pad2/ds2u_d.irx mem value) from 89008A
patch=1,EE,200F1100,extended,3C0F008A
patch=1,EE,200F1104,extended,91EFB0DE
; New extra logic (passing stick value into diffAngle())
patch=1,EE,200F1108,extended,25EFFF81
patch=1,EE,200F110C,extended,448FF000
patch=1,EE,200F1110,extended,4680F7A0
patch=1,EE,200F1114,extended,3C0F3CC9
patch=1,EE,200F1118,extended,448FF800
patch=1,EE,200F111C,extended,461FF7C2
; jump to diffAngle() (will be returing to $ra afterwards to original function body computeViewAngle())
patch=1,EE,200F1120,extended,0808C3C0
patch=1,EE,200F1124,extended,460DFB40
; Disable right analog stick function on Throttle/Brake
patch=1,EE,104387CE,extended,1000
patch=1,EE,104387F6,extended,1000

[Loose Chase Camera]
author=Silent
description=Makes the exterior camera looser when turn like GT3 A-Spec.
; Default parameters in this cheat correspond to the values from GT4 First Preview,
; but you may freely customize them. For example, if you want to make the camera
; even stiffer (like in GT5/6), increase the damper value.
;
; Camera damper, higher values make the camera center quicker
patch=1,EE,106635DA,extended,1E1E // 30.0. Default - 120.0
patch=1,EE,106635DC,extended,1E1E
; Camera max angle, higher values make the camera lean further to the sides
patch=1,EE,106635DE,extended,0A0A // 10.0. Default - 15.0
patch=1,EE,106635E0,extended,0A0A

