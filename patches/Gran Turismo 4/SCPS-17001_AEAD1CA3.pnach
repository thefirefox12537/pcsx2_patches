[360° View Chase Camera]
author=Duchi/Vyerq
description=When looking backwards, the camera can be rotated horizontally with right analog stick.
; Jump to 0xF1100 (custom code) at computeViewAngle() - 0x2033FE88
patch=1,EE,2033FE88,extended,0C03C440
; New function start - Get pad value (pad2/ds2u_d.irx mem value) from 89715E
patch=1,EE,200F1100,extended,3C0F0086
patch=1,EE,200F1104,extended,91EF715E
; New extra logic (passing stick value into diffAngle())
